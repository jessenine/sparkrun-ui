[Unit]
Description=SparkRun Local Agent - Secure process monitoring for cluster nodes
Documentation=https://github.com/mcampa/sparkrun-ui
After=network.target

[Service]
Type=simple
User=sparkrun
Group=sparkrun
ExecStart=/usr/local/bin/sparkrun-local-agent
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sparkrun-local-agent

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log

[Install]
WantedBy=multi-user.target
